# Variables de Docker Compose (copia este archivo a .env en la RAIZ).
# Docker Compose lee automaticamente el .env de la raiz para sustituir ${...}.
#
# OJO: este archivo es solo para desarrollo local. En Render NO se copia nada
# de aqui: las variables se defines en el panel del Web Service.

COMPOSE_PROJECT_NAME=dockerize

# Puertos publicados en tu maquina
WEB_PORT=8000
# PostgreSQL: dentro del contenedor el puerto siempre es 5432. Aqui se publica
# en 5433 porque el 5432 de tu maquina suele estar ocupado por un PostgreSQL
# local (igual que antes se usaba 3307 para MySQL).
DB_PORT=5433
ADMINER_PORT=8082

# PostgreSQL (servicio "db" de docker-compose.yml)
POSTGRES_DB=docker_basico
POSTGRES_USER=dockerize
POSTGRES_PASSWORD=dockerize
TZ=America/Bogota

# DSN que usa la aplicacion. docker-compose.yml la arma sola a partir de las
# variables POSTGRES_* de arriba, asi que normalmente no la definas aqui.
#
# En RENDER si es obligatoria: pega el "Internal Database URL" de tu base.
#   DATABASE_URL=postgresql://USUARIO:CLAVE@dpg-xxxxxxx:5432/docker_basico
DATABASE_URL=

# Ajustes finos de la conexion (opcionales)
# 600 s reutiliza conexiones; en Render es necesario porque el plan gratuito
# apaga el servicio y corta las conexiones.
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=1

# Django
# DEBUG debe ser False en produccion. Con DEBUG=False, DJANGO_SECRET_KEY es
# obligatoria: genera una con
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Render define RENDER_EXTERNAL_HOSTNAME solo (no hace falta crearla a mano).
# SiRender no lo define,DJANGO_ALLOWED_HOSTS debe incluir el dominio:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-servicio.onrender.com
RENDER_EXTERNAL_HOSTNAME=

# Detras del proxy de Render el esquema llega en X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_SECURE_SSL_REDIRECT=0

# 1 = ejecuta "manage.py cargar_datos" al arrancar el contenedor web
DJANGO_CARGAR_DATOS=1

# Solo para docker-compose.prod.yml
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SESSION_COOKIE_SECURE=0
